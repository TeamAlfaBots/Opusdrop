{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/out",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{frontend/**,tests/**,scripts/**,*.db,.env*}"
    }
  },
  "rewrites": [
    { "source": "/preview/:id", "destination": "/preview/index.html" },
    { "source": "/file/:id", "destination": "/api/index" },
    { "source": "/download/:id", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
